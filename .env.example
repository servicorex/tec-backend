# Database Configuration (Supabase PostgreSQL)
# Example: jdbc:postgresql://db.[PROJECT-REF].supabase.co:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/<DATABASE_NAME>
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<YOUR_SUPABASE_DB_PASSWORD>

# JWT Security
# Must be a 256-bit (32+ character) secret string for HMAC-SHA256
JWT_SECRET=<YOUR_STRONG_256_BIT_SECRET_KEY>
JWT_EXPIRATION_HOURS=12

# Server Port (Default: 8080)
PORT=8080

# CORS Whitelist (Allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tec-alpha-lime.vercel.app

